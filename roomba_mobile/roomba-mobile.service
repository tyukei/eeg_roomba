[Unit]
Description=Roomba mobile controller (phone UI + serial bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/home/pi/Documents/eeg_roomba/roomba_mobile
ExecStart=/home/pi/.local/bin/uv run --frozen python app.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# Left unset so the app auto-detects: a USB Arduino (/dev/ttyACM*, /dev/ttyUSB*)
# wins when plugged in, otherwise it falls back to Pi-B's GPIO UART /dev/ttyS0.
# Pin a specific device here only to override that.
Environment=ROOMBA_HTTP_PORT=8000

[Install]
WantedBy=multi-user.target
