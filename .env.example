# PC側 (docker-compose)
POSTGRES_USER=eeg
POSTGRES_PASSWORD=eeg
POSTGRES_DB=eeg
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

MQTT_HOST=mosquitto
MQTT_PORT=1883

# LSL stream name (acquirer 側と一致させる)
LSL_STREAM_NAME=PiEEG-16

# EEG ingest source: "lsl" (default, reads pi-a の LSL outlet) | "file" (.npy fixture を replay)
# file モードは dev / CI 用。本番は lsl のままにする
EEG_SOURCE=lsl
# EEG_SOURCE=file の時のみ参照される (例: /app/test_eeg.npy)
EEG_REPLAY_PATH=

# Roomba-Pi の既存 FastAPI
ROOMBA_HTTP_BASE=http://roomba-pi.local:8000

# decision_svc のα power閾値 (μV^2)。retainでMQTTに上書き可
ALPHA_ENTER_TH=10.0
ALPHA_EXIT_TH=6.0
ALPHA_DWELL_MS=500
# 後頭部相当: 16ch中どのindexを使うか (0-origin、複数ならカンマ区切り)
ALPHA_CHANNELS=6,7
