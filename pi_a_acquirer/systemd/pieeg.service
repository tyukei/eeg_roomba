[Unit]
Description=PiEEG-16 acquisition (SPI -> LSL + MQTT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pieeg
Group=pieeg
SupplementaryGroups=spi gpio
WorkingDirectory=/home/pieeg/Documents/eeg_roomba/pi_a_acquirer
EnvironmentFile=/home/pieeg/Documents/eeg_roomba/pi_a_acquirer/.env
ExecStart=/home/pieeg/.local/bin/uv run --frozen python acquirer.py
Restart=on-failure
RestartSec=2
Nice=-10

[Install]
WantedBy=multi-user.target
