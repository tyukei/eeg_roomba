{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/refuse-destructive-remote.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/tools/hooks/log-remote-ops.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ssh pc:*)",
      "Bash(ssh pi-a:*)",
      "Bash(ssh pi-b:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux has-session:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl is-active:*)",
      "Bash(journalctl:*)",
      "Bash(mosquitto_sub:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -sS http://localhost:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Bash(ssh * sudo rm*)",
      "Bash(ssh * rm -rf*)",
      "Bash(ssh * mkfs*)",
      "Bash(ssh * dd if=*)",
      "Bash(git push --force origin main*)",
      "Bash(git push -f origin main*)"
    ]
  }
}
